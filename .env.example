# Postgres connection string. Locally: your own Postgres or Docker (see README).
# On Railway: reference the Postgres plugin's DATABASE_URL variable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashewtrace?schema=public"

# Cookie-encryption secret, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-string-of-at-least-32-chars"

# Public origin of the app, baked into lot QR codes (no trailing slash).
PUBLIC_BASE_URL="http://localhost:3000"

# PIN for the admin login (settings editor).
ADMIN_PIN="246810"

# Railway sets this for production; leave unset locally.
# NODE_ENV="production"
